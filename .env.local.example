# Neon Postgres (Vercel Storage가 자동 주입. 로컬은 vercel env pull 또는 수동.)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# 외부 API 호출(Custom GPT Actions, curl 등)에 쓰는 Bearer 토큰
JARVIS_API_TOKEN="generate-a-random-uuid-here"

# 웹 UI 로그인용 비밀번호 (Bearer 토큰과 분리해서 보관)
JARVIS_WEB_PASSWORD="generate-another-random-uuid-here"

# 자동 브리핑 루틴 전용 토큰. 스냅샷·브리핑 읽기 + 브리핑 쓰기 + 개선노트만 허용된다.
# 클라우드 루틴 프롬프트에 들어가는 값이라 전권 토큰(JARVIS_API_TOKEN)을 주지 않는다.
# Vercel 환경변수에도 같은 값이 있어야 루틴이 인증된다. (docs/stock.md §자동 브리핑 루틴)
JARVIS_BRIEFING_TOKEN="generate-another-random-hex-here"

# 브리핑 루틴이 수집 워크플로를 즉시 시작시킬 때 쓰는 GitHub fine-grained PAT.
# 권한: 이 레포(jarvis)의 Actions Read and write **한 개만**. KIS 키와 무관하다.
# Vercel 환경변수에도 같은 값 필요. 없으면 /api/stock/collect가 503 → 루틴은 스킵 규칙으로 후퇴.
GITHUB_DISPATCH_TOKEN=""

# OpenDART 공시 수집용 (https://opendart.fss.or.kr → 인증키 신청/관리 → 오픈API 이용현황)
# 수집기(GitHub Actions)에서만 쓴다 — Vercel에는 넣지 않는다. KIS 키와 같은 원칙.
DART_API_KEY=""

# Google Calendar 연동 (단계 2 완료 후 채워짐)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
